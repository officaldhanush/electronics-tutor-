import random
import re
from getpass import getpass
import gradio as gr
from openai import OpenAI

client = OpenAI(
    base_url="https://integrate.api.nvidia.com/v1",
    api_key=getpass("Paste your key: ").strip(),
)

TUTOR_MODEL = "nvidia/nemotron-3.5-lightning-30b-a3b"
REVIEWER_MODEL = "nvidia/nemotron-3-ultra-550b-a55b"

RULES = (
    "You are a friendly electronics tutor for first-year "
    "engineering students. Use simple English and short "
    "examples. Write plain text only: no LaTeX, no markdown "
    "symbols. Write formulas like V = I x R. "
    "Keep answers under 150 words. Never mention word counts."
)

REVIEW_RULES = (
    "You are a strict electronics professor checking a "
    "tutor's answer for first-year students. If the answer "
    "has no factual or calculation errors, reply with the "
    "single word OK. Otherwise, in at most two short "
    "sentences, name the error. Plain text only."
)

def call_ai(model, messages, limit=1000):
    r = client.chat.completions.create(
        model=model,
        messages=messages,
        max_tokens=max(limit, 1500),
    )
    return r.choices[0].message.content or ""

def review(question, answer):
    verdict = call_ai(
        REVIEWER_MODEL,
        [
            {"role": "system", "content": REVIEW_RULES},
            {"role": "user", "content":
                "Question: " + question
                + "\n\nAnswer to check: " + answer},
        ],
        limit=600,
    ).strip()
    if verdict == "":
        return "No reply from the reviewer."
    if verdict.rstrip(".!").upper() == "OK":
        return "No errors found."
    return "Reviewer says: " + verdict

def q_ohm():
    R = random.choice([2, 4, 5, 10, 20, 50, 100])
    I = random.choice([0.1, 0.2, 0.5, 1, 2, 3])
    V = round(I * R, 3)
    kind = random.choice(["V", "I", "R"])
    if kind == "V":
        q = f"A {R} ohm resistor carries {I} A. What is the voltage across it, in volts?"
        return q, V, f"V = I x R = {I} x {R} = {V} V"
    if kind == "I":
        q = f"A {R} ohm resistor has {V} V across it. What is the current, in amps?"
        return q, I, f"I = V / R = {V} / {R} = {I} A"
    q = f"{V} V is across a resistor and {I} A flows through it. What is its resistance, in ohms?"
    return q, R, f"R = V / I = {V} / {I} = {R} ohm"

def q_series():
    n = random.choice([2, 3])
    rs = [random.choice([10, 22, 47, 100, 220]) for _ in range(n)]
    total = sum(rs)
    names = ", ".join(str(r) for r in rs)
    q = f"Resistors of {names} ohms are connected in series. What is the total resistance, in ohms?"
    sol = "In series, resistances add: " + " + ".join(str(r) for r in rs) + f" = {total} ohm"
    return q, total, sol

def q_parallel():
    a, b = random.choice([
        (10, 10), (20, 30), (10, 40), (30, 60), (60, 120),
        (100, 100), (40, 60), (12, 6), (15, 10), (50, 50),
    ])
    total = round(a * b / (a + b), 3)
    q = f"A {a} ohm and a {b} ohm resistor are connected in parallel. What is the total resistance, in ohms?"
    sol = f"In parallel: R = (R1 x R2) / (R1 + R2) = ({a} x {b}) / ({a} + {b}) = {total} ohm"
    return q, total, sol

def q_power():
    if random.choice([True, False]):
        V = random.choice([5, 9, 12, 24])
        I = random.choice([0.1, 0.2, 0.5, 1, 2])
        P = round(V * I, 3)
        q = f"A device runs on {V} V and draws {I} A. How much power does it use, in watts?"
        return q, P, f"P = V x I = {V} x {I} = {P} W"
    I = random.choice([0.1, 0.2, 0.5, 1, 2])
    R = random.choice([10, 20, 50, 100])
    P = round(I * I * R, 3)
    q = f"A current of {I} A flows through a {R} ohm resistor. How much power does it use, in watts?"
    return q, P, f"P = I x I x R = {I} x {I} x {R} = {P} W"

TOPICS = {
    "Ohm's law": q_ohm,
    "Series resistors": q_series,
    "Parallel resistors": q_parallel,
    "Power": q_power,
}

def make_question(topic):
    if topic in TOPICS:
        return TOPICS[topic]()
    return random.choice(list(TOPICS.values()))()

def check_number(reply, correct):
    m = re.search(r"-?\d+(?:\.\d+)?", reply)
    if m is None:
        return None
    return abs(float(m.group()) - correct) <= 0.01 * abs(correct)

def tutor_reply(question, hist):
    question = (question or "").strip()
    if not question:
        return "Please type a question.", "", hist
    hist = hist + [{"role": "user", "content": question}]
    answer = call_ai(TUTOR_MODEL, hist) or "No answer, try again."
    hist = hist + [{"role": "assistant", "content": answer}]
    hist = [hist[0]] + hist[-8:]
    return answer, review(question, answer), hist

def new_quiz(topic):
    q = make_question(topic)
    return q[0], "", "", q

def grade(text, quiz):
    if not quiz:
        return "Press New question first."
    question, correct, solution = quiz
    result = check_number(text or "", correct)
    if result is None:
        return "Please type a number."
    if result:
        return "Correct! " + solution
    tip = call_ai(
        TUTOR_MODEL,
        [
            {"role": "system", "content": RULES},
            {"role": "user", "content":
                "A student was asked: " + question
                + " The student answered: " + text
                + ". The correct answer is " + str(correct)
                + ". In two short sentences, say what mistake "
                "the student probably made. Do not change "
                "the correct answer."},
        ],
        limit=500,
    )
    return "Not quite. " + solution + "\n\n" + tip

def reveal(quiz):
    if not quiz:
        return "Press New question first."
    return "Answer: " + quiz[2]

with gr.Blocks(title="Electronics Tutor") as demo:
    gr.Markdown(
        "# Electronics Tutor\n"
        "Ask questions, or practise Ohm's law, "
        "series, parallel and power."
    )
    with gr.Tab("Ask"):
        hist = gr.State([{"role": "system", "content": RULES}])
        q_box = gr.Textbox(label="Your question", placeholder="What is a resistor?")
        ask_btn = gr.Button("Ask", variant="primary")
        answer_box = gr.Textbox(label="Tutor", lines=8)
        check_box = gr.Textbox(label="Second check", lines=2)
        ask_btn.click(tutor_reply, [q_box, hist], [answer_box, check_box, hist])
    with gr.Tab("Quiz"):
        quiz_state = gr.State(None)
        topic_box = gr.Dropdown(
            choices=["Mixed"] + list(TOPICS),
            value="Mixed",
            label="Topic",
        )
        quiz_text = gr.Textbox(label="Question", lines=3, interactive=False)
        my_answer = gr.Textbox(label="Your answer (number only)")
        with gr.Row():
            new_btn = gr.Button("New question")
            check_btn = gr.Button("Check", variant="primary")
            show_btn = gr.Button("Show answer")
        result_box = gr.Textbox(label="Result", lines=6)
        new_btn.click(new_quiz, topic_box, [quiz_text, my_answer, result_box, quiz_state])
        check_btn.click(grade, [my_answer, quiz_state], result_box)
        show_btn.click(reveal, quiz_state, result_box)

app_password = getpass("Choose an app password: ")
demo.launch(share=True, debug=True, auth=("student", app_password))
