        "\n",
        "!pip install -q openai gradio\n",
        "import random\n",
        "import re\n",
        "from getpass import getpass\n",
        "import gradio as gr\n",
        "from openai import OpenAI\n",
        "\n",
        "client = OpenAI(\n",
        "    base_url=\"https://integrate.api.nvidia.com/v1\",\n",
        "    api_key=getpass(\"Paste your key: \"),\n",
        ")\n",
        "\n",
        "TUTOR_MODEL = \"nvidia/nemotron-3-super-120b-a12b\"\n",
        "REVIEWER_MODEL = \"nvidia/nemotron-3-super-120b-a12b\"\n",
        "\n",
        "RULES = (\n",
        "    \"You are a friendly electronics tutor for first-year \"\n",
        "    \"engineering students. Use simple English and short \"\n",
        "    \"examples. Write plain text only: no LaTeX, no markdown \"\n",
        "    \"symbols. Write formulas like V = I x R. \"\n",
        "    \"Keep answers under 150 words. Never mention word counts.\"\n",
        ")\n",
        "\n",
        "REVIEW_RULES = (\n",
        "    \"You are a strict electronics professor checking a \"\n",
        "    \"tutor's answer for first-year students. If the answer \"\n",
        "    \"has no factual or calculation errors, reply with the \"\n",
        "    \"single word OK. Otherwise, in at most two short \"\n",
        "    \"sentences, name the error. Plain text only.\"\n",
        ")\n",
        "\n",
        "def call_ai(model, messages, limit=1000):\n",
        "    r = client.chat.completions.create(\n",
        "        model=model,\n",
        "        messages=messages,\n",
        "        max_tokens=limit,\n",
        "    )\n",
        "    return r.choices[0].message.content or \"\"\n",
        "\n",
        "def review(question, answer):\n",
        "    verdict = call_ai(\n",
        "        REVIEWER_MODEL,\n",
        "        [\n",
        "            {\"role\": \"system\", \"content\": REVIEW_RULES},\n",
        "            {\"role\": \"user\", \"content\":\n",
        "                \"Question: \" + question\n",
        "                + \"\\n\\nAnswer to check: \" + answer},\n",
        "        ],\n",
        "        limit=600,\n",
        "    ).strip()\n",
        "    if verdict == \"\":\n",
        "        return \"No reply from the reviewer.\"\n",
        "    if verdict.rstrip(\".!\").upper() == \"OK\":\n",
        "        return \"No errors found.\"\n",
        "    return \"Reviewer says: \" + verdict\n",
        "\n",
        "def q_ohm():\n",
        "    R = random.choice([2, 4, 5, 10, 20, 50, 100])\n",
        "    I = random.choice([0.1, 0.2, 0.5, 1, 2, 3])\n",
        "    V = round(I * R, 3)\n",
        "    kind = random.choice([\"V\", \"I\", \"R\"])\n",
        "    if kind == \"V\":\n",
        "        q = f\"A {R} ohm resistor carries {I} A. What is the voltage across it, in volts?\"\n",
        "        return q, V, f\"V = I x R = {I} x {R} = {V} V\"\n",
        "    if kind == \"I\":\n",
        "        q = f\"A {R} ohm resistor has {V} V across it. What is the current, in amps?\"\n",
        "        return q, I, f\"I = V / R = {V} / {R} = {I} A\"\n",
        "    q = f\"{V} V is across a resistor and {I} A flows through it. What is its resistance, in ohms?\"\n",
        "    return q, R, f\"R = V / I = {V} / {I} = {R} ohm\"\n",
        "\n",
        "def q_series():\n",
        "    n = random.choice([2, 3])\n",
        "    rs = [random.choice([10, 22, 47, 100, 220]) for _ in range(n)]\n",
        "    total = sum(rs)\n",
        "    names = \", \".join(str(r) for r in rs)\n",
        "    q = f\"Resistors of {names} ohms are connected in series. What is the total resistance, in ohms?\"\n",
        "    sol = \"In series, resistances add: \" + \" + \".join(str(r) for r in rs) + f\" = {total} ohm\"\n",
        "    return q, total, sol\n",
        "\n",
        "def q_parallel():\n",
        "    a, b = random.choice([\n",
        "        (10, 10), (20, 30), (10, 40), (30, 60), (60, 120),\n",
        "        (100, 100), (40, 60), (12, 6), (15, 10), (50, 50),\n",
        "    ])\n",
        "    total = round(a * b / (a + b), 3)\n",
        "    q = f\"A {a} ohm and a {b} ohm resistor are connected in parallel. What is the total resistance, in ohms?\"\n",
        "    sol = f\"In parallel: R = (R1 x R2) / (R1 + R2) = ({a} x {b}) / ({a} + {b}) = {total} ohm\"\n",
        "    return q, total, sol\n",
        "\n",
        "def q_power():\n",
        "    if random.choice([True, False]):\n",
        "        V = random.choice([5, 9, 12, 24])\n",
        "        I = random.choice([0.1, 0.2, 0.5, 1, 2])\n",
        "        P = round(V * I, 3)\n",
        "        q = f\"A device runs on {V} V and draws {I} A. How much power does it use, in watts?\"\n",
        "        return q, P, f\"P = V x I = {V} x {I} = {P} W\"\n",
        "    I = random.choice([0.1, 0.2, 0.5, 1, 2])\n",
        "    R = random.choice([10, 20, 50, 100])\n",
        "    P = round(I * I * R, 3)\n",
        "    q = f\"A current of {I} A flows through a {R} ohm resistor. How much power does it use, in watts?\"\n",
        "    return q, P, f\"P = I x I x R = {I} x {I} x {R} = {P} W\"\n",
        "\n",
        "TOPICS = {\n",
        "    \"Ohm's law\": q_ohm,\n",
        "    \"Series resistors\": q_series,\n",
        "    \"Parallel resistors\": q_parallel,\n",
        "    \"Power\": q_power,\n",
        "}\n",
        "\n",
        "def make_question(topic):\n",
        "    if topic in TOPICS:\n",
        "        return TOPICS[topic]()\n",
        "    return random.choice(list(TOPICS.values()))()\n",
        "\n",
        "def check_number(reply, correct):\n",
        "    m = re.search(r\"-?\\d+(?:\\.\\d+)?\", reply)\n",
        "    if m is None:\n",
        "        return None\n",
        "    return abs(float(m.group()) - correct) <= 0.01 * abs(correct)\n",
        "\n",
        "def tutor_reply(question, hist):\n",
        "    question = (question or \"\").strip()\n",
        "    if not question:\n",
        "        return \"Please type a question.\", \"\", hist\n",
        "    hist = hist + [{\"role\": \"user\", \"content\": question}]\n",
        "    answer = call_ai(TUTOR_MODEL, hist) or \"No answer, try again.\"\n",
        "    hist = hist + [{\"role\": \"assistant\", \"content\": answer}]\n",
        "    hist = [hist[0]] + hist[-8:]\n",
        "    return answer, review(question, answer), hist\n",
        "\n",
        "def new_quiz(topic):\n",
        "    q = make_question(topic)\n",
        "    return q[0], \"\", \"\", q\n",
        "\n",
        "def grade(text, quiz):\n",
        "    if not quiz:\n",
        "        return \"Press New question first.\"\n",
        "    question, correct, solution = quiz\n",
        "    result = check_number(text or \"\", correct)\n",
        "    if result is None:\n",
        "        return \"Please type a number.\"\n",
        "    if result:\n",
        "        return \"Correct! \" + solution\n",
        "    tip = call_ai(\n",
        "        TUTOR_MODEL,\n",
        "        [\n",
        "            {\"role\": \"system\", \"content\": RULES},\n",
        "            {\"role\": \"user\", \"content\":\n",
        "                \"A student was asked: \" + question\n",
        "                + \" The student answered: \" + text\n",
        "                + \". The correct answer is \" + str(correct)\n",
        "                + \". In two short sentences, say what mistake \"\n",
        "                \"the student probably made. Do not change \"\n",
        "                \"the correct answer.\"},\n",
        "        ],\n",
        "        limit=500,\n",
        "    )\n",
        "    return \"Not quite. \" + solution + \"\\n\\n\" + tip\n",
        "\n",
        "def reveal(quiz):\n",
        "    if not quiz:\n",
        "        return \"Press New question first.\"\n",
        "    return \"Answer: \" + quiz[2]\n",
        "\n",
        "with gr.Blocks(title=\"Electronics Tutor\") as demo:\n",
        "    gr.Markdown(\n",
        "        \"# Electronics Tutor\\n\"\n",
        "        \"Ask questions, or practise Ohm's law, \"\n",
        "        \"series, parallel and power.\"\n",
        "    )\n",
        "    with gr.Tab(\"Ask\"):\n",
        "        hist = gr.State([{\"role\": \"system\", \"content\": RULES}])\n",
        "        q_box = gr.Textbox(label=\"Your question\", placeholder=\"What is a resistor?\")\n",
        "        ask_btn = gr.Button(\"Ask\", variant=\"primary\")\n",
        "        answer_box = gr.Textbox(label=\"Tutor\", lines=8)\n",
        "        check_box = gr.Textbox(label=\"Second check\", lines=2)\n",
        "        ask_btn.click(tutor_reply, [q_box, hist], [answer_box, check_box, hist])\n",
        "    with gr.Tab(\"Quiz\"):\n",
        "        quiz_state = gr.State(None)\n",
        "        topic_box = gr.Dropdown(\n",
        "            choices=[\"Mixed\"] + list(TOPICS),\n",
        "            value=\"Mixed\",\n",
        "            label=\"Topic\",\n",
        "        )\n",
        "        quiz_text = gr.Textbox(label=\"Question\", lines=3, interactive=False)\n",
        "        my_answer = gr.Textbox(label=\"Your answer (number only)\")\n",
        "        with gr.Row():\n",
        "            new_btn = gr.Button(\"New question\")\n",
        "            check_btn = gr.Button(\"Check\", variant=\"primary\")\n",
        "            show_btn = gr.Button(\"Show answer\")\n",
        "        result_box = gr.Textbox(label=\"Result\", lines=6)\n",
        "        new_btn.click(new_quiz, topic_box, [quiz_text, my_answer, result_box, quiz_state])\n",
        "        check_btn.click(grade, [my_answer, quiz_state], result_box)\n",
        "        show_btn.click(reveal, quiz_state, result_box)\n",
        "\n",
        "app_password = getpass(\"Choose an app password: \")\n",
        "demo.launch(share=True, debug=True, auth=(\"student\", app_password))"
      ]
